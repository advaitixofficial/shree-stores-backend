# ===================================
# Shree Stores Backend — Environment
# ===================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/shree-stores

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store Info
STORE_NAME=Shree Stores
STORE_PHONE=+91-9876543210
STORE_EMAIL=info@shreestores.com
STORE_ADDRESS=Lanka, Varanasi, Uttar Pradesh, India

# Store Location (Varanasi)
STORE_LATITUDE=25.2677
STORE_LONGITUDE=82.9913

# Delivery
DEFAULT_DELIVERY_RADIUS_KM=5
DEFAULT_DELIVERY_FEE=0
DEFAULT_FREE_DELIVERY_MINIMUM=0

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*

# Admin Seed
ADMIN_SEED_EMAIL=admin@shreestores.com
ADMIN_SEED_PASSWORD=Admin@123456
